{% comment %}
  ENSNE Hero Section — PSD Accurate
  File: sections/ensne-hero.liquid

  Fonts mapped directly from ENSNE_WEBSITE_PAGES.psd:
  • Wordmark       → 'Archivo Black' (scaleX filled, PSD uses Cubao Wide at 150pt
                      but Archivo Black is the closest self-hosted match at smaller sizes)
  • Pronunciation  → 'Archivo Black' 25pt, color #ededed, tracking 310 → 0.31em
  • Body copy      → 'Atkinson Hyperlegible' Regular + Bold Italic, 10.5pt, tracking 100 → 0.1em
  • Next serving   → 'Archivo Narrow' Regular, ~16.7pt equiv, tracking 220 → 0.22em

  NO Google Fonts import — all fonts self-hosted via @font-face in base.css
{% endcomment %}

<style>
  #ensne-{{ section.id }},
  #ensne-{{ section.id }} *,
  #ensne-{{ section.id }} *::before,
  #ensne-{{ section.id }} *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* ══ SECTION ══ */
  #ensne-{{ section.id }} {
    position: relative;
    width: 100%;
    height: {{ section.settings.section_height }}vh;
    min-height: 520px;
    overflow: hidden;
    background: {{ section.settings.bg_colour }};
  }

  /* ══ FULL BLEED BACKGROUND ══ */
  #ensne-{{ section.id }} .eh-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  #ensne-{{ section.id }} .eh-bg img,
  #ensne-{{ section.id }} .eh-bg video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.img_pos_x }}% {{ section.settings.img_pos_y }}%;
    {%- assign sepia_val = 0 -%}
    {%- assign bw_val    = 0 -%}
    {%- if section.settings.img_filter == 'sepia' -%}
      {%- assign sepia_val = section.settings.filter_intensity | divided_by: 100.0 -%}
    {%- elsif section.settings.img_filter == 'bw' -%}
      {%- assign bw_val = 1 -%}
    {%- endif -%}
    filter: sepia({{ sepia_val }}) grayscale({{ bw_val }})
            brightness({{ section.settings.img_brightness | divided_by: 100.0 }})
            contrast({{ section.settings.img_contrast | divided_by: 100.0 }});
  }

  #ensne-{{ section.id }} .eh-bg-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #c8a96e 0%, #7a5010 40%, #1a0d00 100%);
  }

  /* ══ DARK OVERLAY ══ */
  #ensne-{{ section.id }} .eh-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: {{ section.settings.tint_colour }};
    opacity: {{ section.settings.tint_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  /* ══ WORDMARK — z-index 5 ══
     Font: Archivo Black (PSD PAGE 01 uses this style at large sizes)
     JS measures text width and scaleX-fills to viewport width
     transform-origin: center top so it expands symmetrically
  ══ */
  #ensne-{{ section.id }} .eh-wordmark {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 5;
    pointer-events: none;
    user-select: none;
    line-height: 1;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  #ensne-{{ section.id }} .eh-wordmark .wm-line {
    display: block;
    /* PSD: Cubao Wide or Archivo Black for display headlines */
    font-family:  'Archivo Black', 'Arial Black', Arial, sans-serif;
    font-weight: 400;
    font-size: {{ section.settings.wordmark_size }}vw;
    text-transform: uppercase;
    /* PSD tracking ~0 for display wordmark (tight fill) */
    letter-spacing: -0.02em;
    color: {{ section.settings.wordmark_colour }};
    white-space: nowrap;
    line-height: 0.87;
    transform-origin: center top;
    will-change: transform;
  }

  /* ══ OVERLAY TEXT — z-index 6 ══ */

  /* Pronunciation — top right
     PSD: Archivo Black, 25pt, color #ededed, tracking 310 → 0.31em, lowercase */
  #ensne-{{ section.id }} .eh-pronunciation {
    position: absolute;
    top: {{ section.settings.pronunciation_top }}%;
    right: 3%;
    z-index: 6;
    color: {{ section.settings.pronunciation_colour }};
    font-family: 'Archivo Black', 'Arial Black', sans-serif;
    font-weight: 400;
    font-size: clamp(8px, 0.88vw, 13px);
    /* PSD tracking 310 → 0.31em */
    letter-spacing: 0.31em;
    white-space: nowrap;
    text-transform: lowercase;
  }

  /* Body copy — bottom left
     PSD: Atkinson Hyperlegible Regular+BoldItalic, 10.5pt, #ededed, tracking 100 → 0.1em
     Justified text with inter-word spacing */
  #ensne-{{ section.id }} .eh-copy {
    position: absolute;
    bottom: {{ section.settings.copy_bottom }}%;
    left: {{ section.settings.copy_left }}%;
    z-index: 6;
    width: clamp(200px, {{ section.settings.copy_width }}vw, 540px);
    color: {{ section.settings.copy_colour }};
    font-family: 'Atkinson Hyperlegible', sans-serif;
    font-weight: 400;
    font-size: clamp(9px, {{ section.settings.copy_size }}vw, 14px);
    line-height: 1.75;
    /* PSD tracking 100 → 0.1em */
    letter-spacing: 0.1em;
    text-align: justify;
    text-justify: inter-word;
  }

  #ensne-{{ section.id }} .eh-copy p { margin: 0; }

  /* PSD: "artleisure" = Atkinson Hyperlegible BoldItalic */
  #ensne-{{ section.id }} .eh-copy em {
    font-style: italic;
    font-weight: 700;
    font-family: 'Atkinson Hyperlegible', sans-serif;
  }

  /* PSD: "the tasting menu" = Atkinson Hyperlegible BoldItalic */
  #ensne-{{ section.id }} .eh-copy strong {
    font-weight: 700;
    font-family: 'Atkinson Hyperlegible', sans-serif;
  }

  /* Next serving — bottom right
     PSD: Archivo Narrow Regular, ~16.7pt, #ededed, tracking 220 → 0.22em */
  #ensne-{{ section.id }} .eh-serving {
    position: absolute;
    bottom: {{ section.settings.copy_bottom }}%;
    right: 3%;
    z-index: 6;
    color: {{ section.settings.serving_colour }};
    font-family: 'Archivo Narrow', sans-serif;
    font-weight: 400;
    font-size: clamp(8px, 0.88vw, 13px);
    /* PSD tracking 220 → 0.22em */
    letter-spacing: 0.22em;
    white-space: nowrap;
    text-transform: lowercase;
  }

  /* CTA button
     PSD: Archivo Black, 13pt, tracking 450-570 → 0.45-0.57em, uppercase */
  #ensne-{{ section.id }} .eh-cta {
    position: absolute;
    bottom: calc({{ section.settings.copy_bottom }}% + 3.2rem);
    left: {{ section.settings.copy_left }}%;
    z-index: 6;
    display: inline-block;
    padding: 0.55em 1.6em;
    font-family: 'Archivo Black', 'Arial Black', sans-serif;
    font-weight: 400;
    font-size: clamp(9px, 0.82vw, 12px);
    /* PSD ADD TO BAG tracking 570 → 0.57em; INSPIRATION 450 → 0.45em; use mid value */
    letter-spacing: 0.45em;
    text-transform: uppercase;
    text-decoration: none;
    color: {{ section.settings.cta_text_colour }};
    border: 1px solid {{ section.settings.cta_border_colour }};
    background: transparent;
    transition: background 0.25s ease, color 0.25s ease;
    white-space: nowrap;
  }

  #ensne-{{ section.id }} .eh-cta:hover {
    background: {{ section.settings.cta_border_colour }};
    color: {{ section.settings.bg_colour }};
  }

  /* ══ MOBILE ══ */
  @media (max-width: 820px) {
    #ensne-{{ section.id }} { height: {{ section.settings.mobile_height }}vh; }
    #ensne-{{ section.id }} .eh-copy { width: 80vw; left: 4%; bottom: 5%; font-size: 10px; }
    #ensne-{{ section.id }} .eh-serving { bottom: 5%; right: 4%; font-size: 9px; }
    #ensne-{{ section.id }} .eh-pronunciation { font-size: 9px; }
    #ensne-{{ section.id }} .eh-cta { left: 4%; font-size: 9px; }
  }
</style>

<div id="ensne-{{ section.id }}">

  <!-- Layer 1: Background -->
  <div class="eh-bg">
    {%- if section.settings.background_video != blank -%}
      <video src="{{ section.settings.background_video }}" autoplay muted loop playsinline aria-hidden="true"></video>
    {%- elsif section.settings.background_image != blank -%}
      {%- assign img = section.settings.background_image -%}
      <img
        src="{{ img | image_url: width: 2000 }}"
        srcset="{{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1400 }} 1400w, {{ img | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ img.alt | escape }}"
        loading="eager"
      >
    {%- else -%}
      <div class="eh-bg-placeholder"></div>
    {%- endif -%}
  </div>

  <!-- Layer 2: Overlay -->
  <div class="eh-overlay"></div>

  <!-- Layer 3: Wordmark (JS scales to fill full width) -->
  <div class="eh-wordmark" id="eh-wm-{{ section.id }}" aria-hidden="true">
    <span class="wm-line wm-line1" id="eh-wm1-{{ section.id }}">{{ section.settings.brand_name | upcase }}</span>
  </div>

  <!-- Layer 4: Overlay text -->
  {%- if section.settings.pronunciation != blank -%}
    <p class="eh-pronunciation">{{ section.settings.pronunciation }}</p>
  {%- endif -%}

  <div class="eh-copy">{{ section.settings.hero_copy }}</div>

  {%- if section.settings.next_serving_label != blank -%}
    <p class="eh-serving">{{ section.settings.next_serving_label }}</p>
  {%- endif -%}

  {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
    <a class="eh-cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
  {%- endif -%}

</div>

<script>
(function () {
  function scaleWordmark() {
    var section = document.getElementById('ensne-{{ section.id }}');
    var line1   = document.getElementById('eh-wm1-{{ section.id }}');
    if (!section || !line1) return;

    var containerW = section.offsetWidth;
    line1.style.transform = 'none';
    var textW = line1.scrollWidth;
    if (textW === 0) return;

    var scale = containerW / textW;
    line1.style.transform = 'scaleX(' + scale + ')';
    line1.style.transformOrigin = 'center top';
  }

  function init() {
    scaleWordmark();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(scaleWordmark);
    }
    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(scaleWordmark, 60);
    });
    setTimeout(scaleWordmark, 300);
    setTimeout(scaleWordmark, 800);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{% schema %}
{
  "name": "ENSNE Hero",
  "tag": "section",
  "class": "section-ensne-hero",
  "settings": [
    { "type": "header", "content": "── Brand & Text ──" },
    { "type": "text", "id": "brand_name", "label": "Brand name (wordmark)", "default": "ENSNE" },
    { "type": "text", "id": "pronunciation", "label": "Pronunciation tag (top right)", "default": "pronounced /en'sein/", "info": "Leave blank to hide." },
    { "type": "richtext", "id": "hero_copy", "label": "Body copy (bottom left)", "default": "<p>we are an <em>\"artleisure\"</em> brand, and for our first collection we are serving a seven course indulgence — <strong><em>the tasting menu</em></strong>, curated with blah and blah.</p>" },
    { "type": "text", "id": "next_serving_label", "label": "Next serving label (bottom right)", "default": "next serving [ 05 / 05 ]", "info": "Leave blank to hide." },

    { "type": "header", "content": "── CTA Button ──" },
    { "type": "text", "id": "cta_label", "label": "Button label", "info": "Leave blank to hide." },
    { "type": "url", "id": "cta_link", "label": "Button link" },

    { "type": "header", "content": "── Background Media ──" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "url", "id": "background_video", "label": "Background video URL", "info": "Direct MP4/WebM. Overrides image." },
    { "type": "range", "id": "img_pos_x", "label": "Image horizontal position", "min": 0, "max": 100, "step": 5, "default": 50, "unit": "%" },
    { "type": "range", "id": "img_pos_y", "label": "Image vertical position", "min": 0, "max": 100, "step": 5, "default": 50, "unit": "%" },

    { "type": "header", "content": "── Image Filters ──" },
    { "type": "select", "id": "img_filter", "label": "Filter style", "options": [{ "value": "none", "label": "None" }, { "value": "sepia", "label": "Sepia / warm film" }, { "value": "bw", "label": "Black & White" }], "default": "sepia" },
    { "type": "range", "id": "filter_intensity", "label": "Sepia intensity", "min": 0, "max": 100, "step": 5, "default": 40, "unit": "%" },
    { "type": "range", "id": "img_brightness", "label": "Brightness", "min": 40, "max": 130, "step": 5, "default": 80, "unit": "%" },
    { "type": "range", "id": "img_contrast", "label": "Contrast", "min": 70, "max": 150, "step": 5, "default": 110, "unit": "%" },

    { "type": "header", "content": "── Overlay ──" },
    { "type": "color", "id": "tint_colour", "label": "Overlay colour", "default": "#000000" },
    { "type": "range", "id": "tint_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "default": 0, "unit": "%" },

    { "type": "header", "content": "── Colours ──" },
    { "type": "color", "id": "bg_colour",           "label": "Fallback background",  "default": "#000000" },
    { "type": "color", "id": "wordmark_colour",      "label": "Wordmark colour",       "default": "#000000" },
    { "type": "color", "id": "pronunciation_colour", "label": "Pronunciation colour",  "default": "#ededed", "info": "PSD: #ededed (near-white)" },
    { "type": "color", "id": "copy_colour",          "label": "Body copy colour",      "default": "#ededed", "info": "PSD: #ededed (near-white)" },
    { "type": "color", "id": "serving_colour",       "label": "Next serving colour",   "default": "#ededed", "info": "PSD: #ededed (near-white)" },
    { "type": "color", "id": "cta_text_colour",      "label": "CTA text colour",       "default": "#ffffff" },
    { "type": "color", "id": "cta_border_colour",    "label": "CTA border colour",     "default": "#ffffff" },

    { "type": "header", "content": "── Wordmark ──" },
    {
      "type": "range",
      "id": "wordmark_size",
      "label": "Wordmark base font size",
      "min": 8, "max": 30, "step": 1, "default": 17, "unit": "vw",
      "info": "JS auto-scales to fill full width."
    },

    { "type": "header", "content": "── Body Copy ──" },
    { "type": "range", "id": "copy_size",   "label": "Font size",            "min": 0.7, "max": 2.0, "step": 0.1, "default": 1.1, "unit": "vw" },
    { "type": "range", "id": "copy_width",  "label": "Column width",         "min": 15, "max": 45, "step": 1, "default": 28, "unit": "vw" },
    { "type": "range", "id": "copy_bottom", "label": "Distance from bottom", "min": 2, "max": 20, "step": 0.5, "default": 5, "unit": "%" },
    { "type": "range", "id": "copy_left",   "label": "Distance from left",   "min": 2, "max": 20, "step": 1, "default": 5, "unit": "%" },

    { "type": "header", "content": "── Labels ──" },
    { "type": "range", "id": "pronunciation_top", "label": "Pronunciation vertical position", "min": 20, "max": 70, "step": 1, "default": 31, "unit": "%" },

    { "type": "header", "content": "── Layout ──" },
    { "type": "range", "id": "section_height", "label": "Section height (desktop)", "min": 60, "max": 100, "step": 5, "default": 100, "unit": "vh" },
    { "type": "range", "id": "mobile_height",  "label": "Section height (mobile)",  "min": 50, "max": 100, "step": 5, "default": 85,  "unit": "vh" }
  ],
  "presets": [{ "name": "ENSNE Hero", "category": "Hero" }]
}
{% endschema %}
