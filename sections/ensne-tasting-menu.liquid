                </svg>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

      </div>
    </div>

  </div>
</section>

<script>
(function () {
  function init() {
    var section = document.getElementById('tm-{{ section.id }}');
    if (!section) return;
    var items  = Array.from(section.querySelectorAll('.tm-item'));
    var frames = Array.from(section.querySelectorAll('.tm-img-frame'));
    function activate(idx) {
      items.forEach(function (el, i)  { el.classList.toggle('is-active', i === idx); });
      frames.forEach(function (fr, i) { fr.classList.toggle('is-visible', i === idx); });
    }
    items.forEach(function (item) {
      item.addEventListener('click', function () {
        activate(parseInt(item.getAttribute('data-index'), 10));
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{% schema %}
{
  "name": "ENSNE Tasting Menu",
  "tag": "section",
  "class": "section-ensne-tasting-menu",
  "blocks": [
    {
      "type": "menu_item",
      "name": "Menu Item",
      "settings": [
        { "type": "text",         "id": "item_label", "label": "Label",               "default": "Appetizers" },
        { "type": "image_picker", "id": "item_image", "label": "Image (right panel)", "info": "Shown when item is active. Leave blank for built-in illustration." },
        { "type": "url",          "id": "item_link",  "label": "Link (optional)" }
      ]
    }
  ],
  "settings": [

    { "type": "header", "content": "-- Layout --" },
    { "type": "range", "id": "left_col_width",         "label": "Left column width (%)",      "min": 45, "max": 75, "step": 1,  "default": 60 },
    { "type": "range", "id": "section_padding_top",    "label": "Padding top (px)",           "min": 0,  "max": 120,"step": 2,  "default": 40 },
    { "type": "range", "id": "section_padding_bottom", "label": "Padding bottom (px)",        "min": 0,  "max": 120,"step": 2,  "default": 48 },
    { "type": "range", "id": "section_padding_left",   "label": "Padding left (px)",          "min": 0,  "max": 120,"step": 2,  "default": 76 },
    { "type": "range", "id": "section_padding_right",  "label": "Padding right (px)",         "min": 0,  "max": 80, "step": 2,  "default": 20 },
    { "type": "range", "id": "headline_to_menu_gap",   "label": "Headline to menu list gap (px)", "min": 0, "max": 100, "step": 2, "default": 44 },

    { "type": "header", "content": "-- Headline text --" },
    { "type": "text", "id": "headline_pre",   "label": "Small top line",  "default": "THE" },
    { "type": "text", "id": "headline_line1", "label": "Giant line 1",    "default": "TASTING" },
    { "type": "text", "id": "headline_line2", "label": "Giant line 2",    "default": "MENU" },

    { "type": "header", "content": "-- THE pre-line typography --" },
    { "type": "range", "id": "pre_font_size",      "label": "Font size (px)",                    "min": 12, "max": 80,  "step": 1,   "default": 32 },
    { "type": "range", "id": "pre_font_weight",    "label": "Font weight",                       "min": 400,"max": 900, "step": 100, "default": 900 },
    { "type": "range", "id": "pre_letter_spacing", "label": "Letter spacing (divide by 100 = em)","min": -5, "max": 50,  "step": 1,   "default": 4, "info": "e.g. 4 = 0.04em" },
    { "type": "range", "id": "pre_bottom_gap",     "label": "Gap below THE (px)",                "min": 0,  "max": 20,  "step": 1,   "default": 0 },

    { "type": "header", "content": "-- Giant headline typography (TASTING / MENU) --" },
