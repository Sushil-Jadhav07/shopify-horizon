{% comment %}
  ENSNE - The Tasting Menu Section
  File: sections/ensne-tasting-menu.liquid
  Nav removed - handled by global theme header.
  Subtitle sits beside "MENU" in a flex row, top-aligned to MENU.
  All font sizes in px - no clamp(), no vw/vh on text.
{% endcomment %}

<style>
  #tm-{{ section.id }},
  #tm-{{ section.id }} *,
  #tm-{{ section.id }} *::before,
  #tm-{{ section.id }} *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* ══ SECTION ══ */
  #tm-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background-color: {{ section.settings.bg_colour }};
    font-family: var(--font-body);
    font-weight: 400;
    font-style: normal;
    overflow: clip;
  }

  /* ── Canvas / linen texture overlay ── */
  #tm-{{ section.id }} .tm-texture {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    {%- if section.settings.bg_texture != blank -%}
      background-image: url('{{ section.settings.bg_texture | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
    {%- else -%}
      background-image:
        repeating-linear-gradient(0deg,  transparent, transparent 2px, rgba(0,0,0,0.028) 2px, rgba(0,0,0,0.028) 3px),
        repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(0,0,0,0.028) 2px, rgba(0,0,0,0.028) 3px);
    {%- endif -%}
    opacity: {{ section.settings.bg_opacity | divided_by: 100.0 }};
  }

  /* ══ TWO-COLUMN GRID ══ */
  #tm-{{ section.id }} .tm-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: {{ section.settings.left_col_width }}% {{ section.settings.left_col_width | minus: 100 | abs }}%;
    min-height: 100vh;
  }

  /* ══ LEFT COLUMN ══ */
  #tm-{{ section.id }} .tm-left {
    padding-top:    {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    padding-left:   {{ section.settings.section_padding_left }}px;
    padding-right:  {{ section.settings.section_padding_right }}px;
    display: flex;
    flex-direction: column;
  }

  /* ══ HEADLINE BLOCK ══
     Contains: THE (small) / TASTING (big) / MENU + subtitle (flex row)
     margin-bottom pushes down to menu list
  ══ */
  #tm-{{ section.id }} .tm-top-block {
    margin-bottom: {{ section.settings.headline_to_menu_gap }}px;
  }

  /* ── "THE" small pre-line ──
     Sits at the very top, same left edge as TASTING.
     Small size, moderate tracking, tight line-height.
  ── */
  #tm-{{ section.id }} .tm-pre {
    display: block;
    font-family: var(--font-display, 'Archivo Black', sans-serif);
    font-weight: {{ section.settings.pre_font_weight }};
    font-size: {{ section.settings.pre_font_size }}px;
    line-height: 1;
    color: {{ section.settings.headline_colour }};
    letter-spacing: {{ section.settings.pre_letter_spacing | divided_by: 100.0 }}em;
    margin-bottom: {{ section.settings.pre_bottom_gap }}px;
    text-transform: uppercase;
  }

  /* ── "TASTING" — full-width giant line ── */
  #tm-{{ section.id }} .tm-big {
    display: block;
    font-family: var(--font-display, 'Archivo Black', sans-serif);
    font-weight: {{ section.settings.headline_font_weight }};
    font-size: {{ section.settings.headline_font_size }}px;
    line-height: {{ section.settings.headline_line_height | divided_by: 100.0 }};
    color: {{ section.settings.headline_colour }};
    letter-spacing: {{ section.settings.headline_letter_spacing | divided_by: 100.0 }}em;
    text-transform: uppercase;
  }

  /* ── MENU ROW: "MENU" + subtitle side by side ──
     Design: subtitle sits to the RIGHT of MENU, top-aligned (flex-start).
     The subtitle top aligns with the top of the MENU text cap-height.
  ── */
  #tm-{{ section.id }} .tm-menu-row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: {{ section.settings.menu_subtitle_gap }}px;
  }

  /* ── Subtitle block — beside MENU ──
     Fixed width box. Top-aligned with MENU line.
     Small narrow font, justified text.
     Has its own top padding to push it down from the MENU cap-height
     to the visual baseline area shown in the design (~top of x-height).
  ── */
  #tm-{{ section.id }} .tm-subtitle-wrap {
    padding-top: {{ section.settings.subtitle_top_offset }}px;
    width: {{ section.settings.subtitle_width }}px;
    flex-shrink: 0;
  }

  #tm-{{ section.id }} .tm-subtitle {
    font-family: var(--font-label, 'Archivo Narrow', sans-serif);
    font-weight: {{ section.settings.subtitle_font_weight }};
    font-style: normal;
    font-size: {{ section.settings.subtitle_font_size }}px;
    line-height: {{ section.settings.subtitle_line_height | divided_by: 100.0 }};
    letter-spacing: {{ section.settings.subtitle_letter_spacing | divided_by: 100.0 }}em;
    color: {{ section.settings.subtitle_colour }};
    text-align: justify;
  }

  /* Bold italic accent inside subtitle */
  #tm-{{ section.id }} .tm-subtitle strong,
  #tm-{{ section.id }} .tm-subtitle b {
    font-weight: {{ section.settings.subtitle_accent_weight }};
    font-style: italic;
    color: {{ section.settings.accent_colour }};
  }

  /* ══ MENU LIST ══ */
  #tm-{{ section.id }} .tm-menu {
    list-style: none;
    width: 100%;
  }

  /* ── Each menu item row ── */
  #tm-{{ section.id }} .tm-item {
    display: flex;
    align-items: center;
    padding: {{ section.settings.item_padding_v }}px 0;
    font-family: var(--font-menu, 'Atkinson Hyperlegible', sans-serif);
    font-weight: {{ section.settings.item_font_weight }};
    font-style: normal;
    font-size: {{ section.settings.item_font_size }}px;
    line-height: 1;
    letter-spacing: {{ section.settings.item_letter_spacing | divided_by: 100.0 }}em;
    text-transform: uppercase;
    color: {{ section.settings.menu_colour }};
    cursor: pointer;
    transition: color 0.25s ease;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  /* ── Label wrapper: text sits above the patch pseudo-element ── */
  #tm-{{ section.id }} .tm-item .tm-label {
    display: inline-block;
    position: relative;
    /* No background here — patch is on ::before so text is always on top */
    background: none !important;
    line-height: inherit;
  }

  /* ── Patch pseudo-element — sits strictly BEHIND the text ──
     top      = {{ section.settings.patch_top }}px  (from schema)
     height   = {{ section.settings.patch_height }}px (from schema)
     max-width = {{ section.settings.patch_max_width }}px (from schema)
     left/right padding = patch_padding_h
  ── */
  #tm-{{ section.id }} .tm-item .tm-label::before {
    content: '';
    position: absolute;
    top:    {{ section.settings.patch_top }}px;
    left:   -{{ section.settings.patch_padding_h }}px;
    height: {{ section.settings.patch_height }}px;
    width:  calc(100% + {{ section.settings.patch_padding_h | times: 2 }}px);
    max-width: {{ section.settings.patch_max_width }}px;
    z-index: -1;
    background-color: transparent;
    background-image: none;
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position: left center;
    opacity: 0;
    transition: opacity 0.22s ease;
    pointer-events: none;
  }

  /* Active item */
  #tm-{{ section.id }} .tm-item.is-active {
    color: {{ section.settings.menu_active_colour }};
  }
  #tm-{{ section.id }} .tm-item.is-active .tm-label::before {
    {%- if section.settings.patch_image != blank -%}
      background-image: url('{{ section.settings.patch_image | image_url: width: 600 }}');
      background-color: transparent;
    {%- else -%}
      background-image: none;
      background-color: {{ section.settings.patch_colour }};
    {%- endif -%}
    opacity: 1;
  }

  /* Hover (inactive only) */
  #tm-{{ section.id }} .tm-item:hover:not(.is-active) {
    color: {{ section.settings.menu_active_colour }};
  }
  #tm-{{ section.id }} .tm-item:hover:not(.is-active) .tm-label::before {
    {%- if section.settings.patch_image != blank -%}
      background-image: url('{{ section.settings.patch_image | image_url: width: 600 }}');
      background-color: transparent;
    {%- else -%}
      background-image: none;
      background-color: {{ section.settings.patch_colour }}66;
    {%- endif -%}
    opacity: 0.55;
  }

  /* ══ RIGHT COLUMN - image panel ══ */
  #tm-{{ section.id }} .tm-right {
    position: relative;
    overflow: visible;
  }

  /* Image stack: anchored bottom-right, bleeds off right edge */
  #tm-{{ section.id }} .tm-img-stack {
    position: absolute;
    bottom: 0;
    right: {{ section.settings.img_bleed_right | times: -1 }}px;
    width: {{ section.settings.img_width }}px;
    height: {{ section.settings.img_height }}px;
  }

  #tm-{{ section.id }} .tm-img-frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }
  #tm-{{ section.id }} .tm-img-frame.is-visible {
    opacity: 1;
    pointer-events: auto;
  }
  #tm-{{ section.id }} .tm-img-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right bottom;
    display: block;
  }
  #tm-{{ section.id }} .tm-img-frame svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ══ MOBILE ══ */
  @media (max-width: 768px) {
    #tm-{{ section.id }} .tm-inner {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    #tm-{{ section.id }} .tm-left {
      padding: 24px 20px 28px 20px;
    }
    #tm-{{ section.id }} .tm-pre {
      font-size: {{ section.settings.pre_font_size | times: 0.65 | round }}px;
    }
    #tm-{{ section.id }} .tm-big {
      font-size: {{ section.settings.headline_font_size | times: 0.5 | round }}px;
    }
    #tm-{{ section.id }} .tm-menu-row {
      flex-direction: column;
      gap: 10px;
    }
    #tm-{{ section.id }} .tm-subtitle-wrap {
      width: 100%;
      max-width: 320px;
      padding-top: 0;
    }
    #tm-{{ section.id }} .tm-item {
      font-size: {{ section.settings.item_font_size | times: 0.8 | round }}px;
    }
    #tm-{{ section.id }} .tm-right {
      height: 55vw;
      min-height: 200px;
      max-height: 360px;
      overflow: hidden;
    }
    #tm-{{ section.id }} .tm-img-stack {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      right: 0;
    }
    #tm-{{ section.id }} .tm-img-frame {
      justify-content: center;
      align-items: center;
    }
  }
</style>

<section id="tm-{{ section.id }}">

  <div class="tm-texture"></div>

  <div class="tm-inner">

    <!-- LEFT column: THE / TASTING / MENU+subtitle / menu list -->
    <div class="tm-left">

      <div class="tm-top-block">

        <!-- "THE" small line -->
        <span class="tm-pre">{{ section.settings.headline_pre }}</span>

        <!-- "TASTING" giant -->
        <span class="tm-big">{{ section.settings.headline_line1 }}</span>

        <!-- "MENU" + subtitle flex row, subtitle top-aligned beside MENU -->
        <div class="tm-menu-row">
          <span class="tm-big">{{ section.settings.headline_line2 }}</span>
          <div class="tm-subtitle-wrap">
            <div class="tm-subtitle">{{ section.settings.subtitle }}</div>
          </div>
        </div>

      </div>

      <!-- Menu items list -->
      <ul class="tm-menu">
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu_item' -%}
            <li
              class="tm-item{% if forloop.first %} is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <span class="tm-label">{{- block.settings.item_label -}}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

    </div>

    <!-- RIGHT column: image stack bottom-right -->
    <div class="tm-right">
      <div class="tm-img-stack">

        {%- for block in section.blocks -%}
          {%- if block.type == 'menu_item' -%}
            <div
              class="tm-img-frame{% if forloop.first %} is-visible{% endif %}"
              data-index="{{ forloop.index0 }}"
            >
              {%- if block.settings.item_image != blank -%}
                <img
                  src="{{ block.settings.item_image | image_url: width: 1200 }}"
                  alt="{{ block.settings.item_label | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
