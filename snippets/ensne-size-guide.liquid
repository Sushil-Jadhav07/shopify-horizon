{% doc %}
  Renders the ENSNE size guide drawer for a product.

  Supports a JSON metafield at `product.metafields.custom.size_guide`
  with rows like [{ size, chest, shoulder, length }] or parallel product
  metafields `size_guide_chest`, `size_guide_shoulder`, `size_guide_length`.

  @param {product} product - Product resource for size guide data.
  @param {string} [guide_id] - Unique dialog component id.
  @param {string} [heading] - Drawer heading.
  @param {string} [subtitle] - Drawer subtitle.
  @param {string} [size_heading] - Size table column heading.
  @param {string} [chest_heading] - Chest table column heading.
  @param {string} [shoulder_heading] - Shoulder table column heading.
  @param {string} [length_heading] - Length table column heading.
  @param {string} [manual_rows] - Newline separated fallback rows: Size | Chest | Shoulder | Length.
  @param {string} [note_heading] - Notes heading.
  @param {string} [notes] - Newline separated fallback notes.
{% enddoc %}

{% liquid
  if guide_id == blank
    assign guide_id = 'ensne-size-guide-' | append: product.id
  endif
  assign heading = heading | default: 'SIZE GUIDE'
  assign subtitle = subtitle | default: 'All measurements are in inches.'
  assign size_heading = size_heading | default: 'SIZE'
  assign chest_heading = chest_heading | default: 'CHEST'
  assign shoulder_heading = shoulder_heading | default: 'SHOULDER'
  assign length_heading = length_heading | default: 'LENGTH'
  assign note_heading = note_heading | default: 'NOTE:'

  assign size_option = blank
  for option in product.options_with_values
    assign option_name_downcase = option.name | downcase
    if option_name_downcase contains 'size'
      assign size_option = option
      break
    endif
  endfor

  assign size_guide_data = product.metafields.custom.size_guide.value
  assign size_guide_rows = blank
  assign size_guide_notes = blank
  if size_guide_data != blank
    if size_guide_data.rows != blank
      assign size_guide_rows = size_guide_data.rows
      assign size_guide_notes = size_guide_data.notes
    else
      assign size_guide_rows = size_guide_data
    endif
  endif

  assign chest_values = product.metafields.custom.size_guide_chest.value | default: '' | split: ','
  assign shoulder_values = product.metafields.custom.size_guide_shoulder.value | default: '' | split: ','
  assign length_values = product.metafields.custom.size_guide_length.value | default: '' | split: ','
  assign notes_text = product.metafields.custom.size_guide_notes.value | default: ''
  assign notes_list = notes_text | split: '|'
  assign manual_row_list = manual_rows | newline_to_br | split: '<br />'
  assign manual_note_list = notes | newline_to_br | split: '<br />'

  assign has_size_guide = false
  if size_guide_rows != blank or manual_rows != blank or size_option != blank
    assign has_size_guide = true
  endif
%}

{% if has_size_guide %}
  <dialog-component
    id="{{ guide_id }}"
    class="ensne-size-guide"
  >
    <dialog
      ref="dialog"
      class="ensne-size-guide__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}"
      scroll-lock
      aria-labelledby="{{ guide_id }}-heading"
    >
      <div class="ensne-size-guide__shell">
        <div class="ensne-size-guide__body">
          <div class="ensne-size-guide__header">
            <button
              class="ensne-size-guide__close button-unstyled close-button"
              type="button"
              on:click="dialog-component/closeDialog"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
            <h2
              id="{{ guide_id }}-heading"
              class="ensne-size-guide__title"
            >
              {{ heading | escape }}
            </h2>
            {% if subtitle != blank %}
              <p class="ensne-size-guide__subtitle">{{ subtitle | escape }}</p>
            {% endif %}
          </div>

          <div class="ensne-size-guide__table-wrap">
            <table class="ensne-size-guide__table">
              <thead>
                <tr>
                  <th>{{ size_heading | escape }}</th>
                  <th>{{ chest_heading | escape }}</th>
                  <th>{{ shoulder_heading | escape }}</th>
                  <th>{{ length_heading | escape }}</th>
                </tr>
              </thead>
              <tbody>
                {% if size_guide_rows != blank %}
                  {% for row in size_guide_rows %}
                    <tr>
                      <td>{{ row.size | default: row.label | default: row.name }}</td>
                      <td>{{ row.chest | default: row.bust }}</td>
                      <td>{{ row.shoulder }}</td>
                      <td>{{ row.length }}</td>
                    </tr>
                  {% endfor %}
                {% elsif manual_rows != blank %}
                  {% for manual_row in manual_row_list %}
                    {% assign manual_row_clean = manual_row | strip %}
                    {% assign columns = manual_row_clean | split: '|' %}
                    {% if manual_row_clean != blank %}
                      <tr>
                        <td>{{ columns[0] | strip }}</td>
                        <td>{{ columns[1] | strip }}</td>
                        <td>{{ columns[2] | strip }}</td>
                        <td>{{ columns[3] | strip }}</td>
                      </tr>
                    {% endif %}
                  {% endfor %}
                {% elsif size_option != blank %}
                  {% for option_value in size_option.values %}
                    <tr>
                      <td>{{ option_value }}</td>
                      <td>{{ chest_values[forloop.index0] | strip }}</td>
                      <td>{{ shoulder_values[forloop.index0] | strip }}</td>
                      <td>{{ length_values[forloop.index0] | strip }}</td>
                    </tr>
                  {% endfor %}
                {% endif %}
              </tbody>
            </table>
          </div>
        </div>

        <div class="ensne-size-guide__note">
          <p class="ensne-size-guide__note-title">{{ note_heading | escape }}</p>
          <ul class="ensne-size-guide__note-list">
            {% if size_guide_notes != blank %}
              {% for note in size_guide_notes %}
                <li>{{ note }}</li>
              {% endfor %}
            {% elsif notes_text != blank %}
              {% for note in notes_list %}
                <li>{{ note | strip }}</li>
              {% endfor %}
            {% elsif notes != blank %}
              {% for note in manual_note_list %}
                {% assign note_clean = note | strip %}
                {% if note_clean != blank %}
                  <li>{{ note_clean }}</li>
                {% endif %}
              {% endfor %}
            {% else %}
              <li>Refer to the garment measurements before choosing your size.</li>
              <li>Compare against a similar garment you already own for best fit.</li>
              <li>Measurements can vary slightly from one product to another.</li>
            {% endif %}
          </ul>
        </div>
      </div>
    </dialog>
  </dialog-component>

  {% stylesheet %}
    .ensne-size-guide__dialog {
      --dialog-drawer-opening-animation: move-and-fade;
      --dialog-drawer-closing-animation: move-and-fade;
      margin: 0 0 0 auto;
      width: min(42vw, 560px);
      max-width: 100%;
      height: 100dvh;
      max-height: 100dvh;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: #f6f3f3;
      color: #111;
      overflow: hidden;
    }

    .ensne-size-guide__shell {
      display: grid;
      grid-template-rows: 1fr auto;
      min-height: 100%;
    }

    .ensne-size-guide__body {
      padding: 34px 42px 28px;
    }

    .ensne-size-guide__header {
      position: relative;
      padding-top: 52px;
    }

    .ensne-size-guide__close {
      position: absolute;
      top: 0;
      right: -6px;
      color: #111;
      padding: 0;
    }

    .ensne-size-guide__close svg {
      width: 24px;
      height: 24px;
      stroke: currentcolor;
      fill: none;
      stroke-width: 1.25;
    }

    .ensne-size-guide__title {
      margin: 0;
      font-family: 'Archivo Narrow', sans-serif;
      font-size: 17px;
      line-height: 1;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .ensne-size-guide__subtitle {
      margin: 8px 0 0;
      font-family: 'Archivo Narrow', sans-serif;
      font-size: 12px;
      line-height: 1.4;
      letter-spacing: 0.18em;
      color: #9a9696;
    }

    .ensne-size-guide__table-wrap {
      margin-top: 46px;
    }

    .ensne-size-guide__table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    .ensne-size-guide__table th,
    .ensne-size-guide__table td {
      padding: 14px 8px;
      text-align: center;
      border-bottom: 1px solid #beb8b8;
      font-family: 'Archivo Narrow', sans-serif;
      font-size: 14px;
      line-height: 1.2;
    }

    .ensne-size-guide__table th {
      padding-bottom: 16px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .ensne-size-guide__table th + th,
    .ensne-size-guide__table td + td {
      border-left: 1px solid #beb8b8;
    }

    .ensne-size-guide__table th:first-child,
    .ensne-size-guide__table td:first-child {
      width: 18%;
    }

    .ensne-size-guide__note {
      background: #6b001f;
      color: #fff;
      padding: 32px 58px 34px;
    }

    .ensne-size-guide__note-title {
      margin: 0 0 10px;
      font-family: 'Archivo Narrow', sans-serif;
      font-size: 16px;
      line-height: 1;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .ensne-size-guide__note-list {
      margin: 0;
      padding-left: 14px;
    }

    .ensne-size-guide__note-list li {
      font-family: 'Archivo Narrow', sans-serif;
      font-size: 11px;
      line-height: 1.55;
      letter-spacing: 0.14em;
      color: rgba(255, 255, 255, 0.78);
    }

    @media screen and (max-width: 749px) {
      .ensne-size-guide__dialog {
        width: 100%;
      }

      .ensne-size-guide__body {
        padding: 28px 18px 24px;
      }

      .ensne-size-guide__note {
        padding: 24px 20px 28px;
      }

      .ensne-size-guide__table th,
      .ensne-size-guide__table td {
        font-size: 12px;
        padding: 12px 6px;
      }
    }
  {% endstylesheet %}
{% endif %}
