{% doc %}
  Renders the ENSNE size chart trigger row and drawer.

  The chart pulls product metafields first, then falls back to manually entered
  rows in this block, then to product size option values.
{% enddoc %}

{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif

  assign size_option = blank
  if product_resource != blank
    for option in product_resource.options_with_values
      assign option_name_downcase = option.name | downcase
      if option_name_downcase contains 'size'
        assign size_option = option
        break
      endif
    endfor
  endif

  assign guide_id = 'ensne-size-guide-' | append: product_resource.id | append: '-' | append: block.id
  assign show_block = false
  if product_resource != blank
    if block.settings.show_without_size_option or size_option != blank
      assign show_block = true
    endif
  endif
%}

{% if show_block %}
  <div
    class="ensne-size-chart-block spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    <div class="ensne-size-guide-row">
      <span class="ensne-size-guide-label">{{ block.settings.label | escape }}</span>
      <button
        type="button"
        class="ensne-size-guide-trigger button-unstyled"
        on:click="#{{ guide_id }}/showDialog"
        aria-haspopup="dialog"
        aria-controls="{{ guide_id }}"
      >
        {{ block.settings.trigger_label | escape }}
      </button>
    </div>

    {% render 'ensne-size-guide',
      product: product_resource,
      guide_id: guide_id,
      heading: block.settings.heading,
      subtitle: block.settings.subtitle,
      size_heading: block.settings.size_heading,
      chest_heading: block.settings.chest_heading,
      shoulder_heading: block.settings.shoulder_heading,
      length_heading: block.settings.length_heading,
      manual_rows: block.settings.manual_rows,
      notes: block.settings.notes,
      note_heading: block.settings.note_heading
    %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Size chart",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "select a size"
    },
    {
      "type": "text",
      "id": "trigger_label",
      "label": "Trigger label",
      "default": "guide"
    },
    {
      "type": "checkbox",
      "id": "show_without_size_option",
      "label": "Show when product has no Size option",
      "default": false
    },
    {
      "type": "header",
      "content": "Drawer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SIZE GUIDE"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "All measurements are in inches."
    },
    {
      "type": "text",
      "id": "size_heading",
      "label": "Size column",
      "default": "SIZE"
    },
    {
      "type": "text",
      "id": "chest_heading",
      "label": "Chest column",
      "default": "CHEST"
    },
    {
      "type": "text",
      "id": "shoulder_heading",
      "label": "Shoulder column",
      "default": "SHOULDER"
    },
    {
      "type": "text",
      "id": "length_heading",
      "label": "Length column",
      "default": "LENGTH"
    },
    {
      "type": "textarea",
      "id": "manual_rows",
      "label": "Manual rows",
      "info": "One row per line: Size | Chest | Shoulder | Length. Product metafields override these rows.",
      "default": "S | 42 | 17 | 24\nM | 43 | 17.5 | 25\nL | 44 | 18 | 26"
    },
    {
      "type": "text",
      "id": "note_heading",
      "label": "Note heading",
      "default": "NOTE:"
    },
    {
      "type": "textarea",
      "id": "notes",
      "label": "Notes",
      "info": "One note per line. Product size guide notes metafield overrides this text.",
      "default": "This product does not follow regular fit sizing.\nIf you usually wear M in regular fit, we recommend choosing S in this oversized fit.\nSizes may differ from regular fit garments."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Size chart",
      "category": "Product"
    }
  ]
}
{% endschema %}
